rules_version = '2';

// ─────────────────────────────────────────────────────────────────────────────
//  CampusFinder — Firestore Security Rules
//  Deploy: Firebase Console → Firestore → Rules → paste → Publish
// ─────────────────────────────────────────────────────────────────────────────

service cloud.firestore {
  match /databases/{database}/documents {

    // Any signed-in Firebase user
    function isLoggedIn() {
      return request.auth != null;
    }

    // ── Items ─────────────────────────────────────────────────────────────────
    //   • Any logged-in user can read all items
    //   • Only the reporter can create (must set reportedBy to own uid)
    //   • Only the reporter can update or delete their item
    match /items/{itemId} {
      allow read:           if isLoggedIn();
      allow create:         if isLoggedIn()
                               && request.resource.data.reportedBy == request.auth.uid;
      allow update, delete: if isLoggedIn()
                               && resource.data.reportedBy == request.auth.uid;
    }

    // ── Chats ─────────────────────────────────────────────────────────────────
    //   • Only the two participants can read or update a chat document
    //   • Only a participant can create a new chat
    //   • Chats cannot be deleted
    match /chats/{chatId} {
      allow read,
            update: if isLoggedIn()
                       && request.auth.uid in resource.data.participants;

      allow create: if isLoggedIn()
                       && request.auth.uid in request.resource.data.participants
                       && request.resource.data.participants.size() == 2;

      allow delete: if false;

      // ── Messages sub-collection ─────────────────────────────────────────────
      //   • Only participants of the parent chat can read messages
      //   • Only a participant can send a message (senderId must equal own uid)
      //   • Messages are immutable once sent
      match /messages/{messageId} {
        allow read:   if isLoggedIn()
                         && request.auth.uid in
                            get(/databases/$(database)/documents/chats/$(chatId))
                              .data.participants;

        allow create: if isLoggedIn()
                         && request.auth.uid in
                            get(/databases/$(database)/documents/chats/$(chatId))
                              .data.participants
                         && request.resource.data.senderId == request.auth.uid;

        allow update,
              delete: if false;
      }
    }

  }
}
